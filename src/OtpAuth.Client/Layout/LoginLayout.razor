@inherits LayoutComponentBase

<div class="login-layout">
    <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center justify-center" Style="min-height: 100vh;">
        <MudPaper Elevation="6" Class="pa-8 width-100" Style="width: 100%; border-radius: 16px;">
            <div class="d-flex flex-column align-center mb-6">
                <MudIcon Icon="@Icons.Material.Filled.Sms" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-2">Güvenli Giriş</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Telefonunuza gelen kod ile giriş yapın</MudText>
            </div>
            @Body
        </MudPaper>
    </MudContainer>
</div>

